{
  "lexicon": 1,
  "id": "app.attrails.v0.route",
  "defs": {
    "commute": {
      "type": "token",
      "description": "Utility / commuting."
    },
    "cyclingDetails": {
      "type": "object",
      "description": "Cycling-specific attributes of a route.",
      "properties": {
        "discipline": {
          "type": "string",
          "knownValues": [
            "app.attrails.v0.route#road",
            "app.attrails.v0.route#gravelBike",
            "app.attrails.v0.route#mtb",
            "app.attrails.v0.route#touring",
            "app.attrails.v0.route#commute"
          ]
        }
      }
    },
    "gravelBike": {
      "type": "token",
      "description": "Gravel / adventure cycling."
    },
    "main": {
      "type": "record",
      "description": "A route for a human-powered activity (cycling, running, hiking, ...) shared by a user. The GPX track is stored as a blob; all geographic statistics are derived by the AppView from the blob and are not part of this record.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "name",
          "activity",
          "gpx",
          "createdAt"
        ],
        "properties": {
          "activity": {
            "type": "string",
            "description": "The activity this route is intended for. Open enum; unknown values are allowed.",
            "knownValues": [
              "app.attrails.v0.defs#cycling",
              "app.attrails.v0.defs#running",
              "app.attrails.v0.defs#hiking",
              "app.attrails.v0.defs#walking",
              "app.attrails.v0.defs#other"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "maxLength": 30000,
            "maxGraphemes": 3000
          },
          "details": {
            "type": "union",
            "description": "Activity-specific attributes. Open union: new activity detail types can be added later without breaking existing clients.",
            "refs": [
              "app.attrails.v0.route#cyclingDetails"
            ]
          },
          "difficulty": {
            "type": "string",
            "description": "Author's subjective difficulty for the stated activity.",
            "knownValues": [
              "app.attrails.v0.defs#easy",
              "app.attrails.v0.defs#moderate",
              "app.attrails.v0.defs#hard",
              "app.attrails.v0.defs#extreme"
            ]
          },
          "gpx": {
            "type": "blob",
            "description": "GPX 1.1 track. Upload with Content-Type application/gpx+xml. maxSize matches the default Bluesky PDS blob limit (976.5625KB); larger routes must be simplified or compressed to fit.",
            "accept": [
              "application/gpx+xml",
              "application/xml",
              "text/xml"
            ],
            "maxSize": 976563
          },
          "images": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "app.attrails.v0.defs#image"
            },
            "maxLength": 10
          },
          "name": {
            "type": "string",
            "description": "Name of the route. Must not be empty; the AppView rejects records with an empty name (lexicon has no minLength, so this cannot be expressed in-schema).",
            "maxLength": 1000,
            "maxGraphemes": 100
          },
          "surface": {
            "type": "string",
            "description": "Predominant surface. Activity-neutral.",
            "knownValues": [
              "app.attrails.v0.defs#paved",
              "app.attrails.v0.defs#gravel",
              "app.attrails.v0.defs#trail",
              "app.attrails.v0.defs#mixed"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 640,
              "maxGraphemes": 64
            },
            "maxLength": 20
          }
        }
      }
    },
    "mtb": {
      "type": "token",
      "description": "Mountain biking."
    },
    "road": {
      "type": "token",
      "description": "Road cycling."
    },
    "touring": {
      "type": "token",
      "description": "Multi-day touring / bikepacking."
    }
  }
}