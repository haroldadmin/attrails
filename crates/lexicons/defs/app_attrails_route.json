{
  "lexicon": 1,
  "id": "app.attrails.route",
  "defs": {
    "commute": {
      "type": "token",
      "description": "Utility / commuting."
    },
    "cyclingDetails": {
      "type": "object",
      "description": "Cycling-specific attributes of a route.",
      "properties": {
        "discipline": {
          "type": "string",
          "knownValues": [
            "app.attrails.route#road",
            "app.attrails.route#gravelBike",
            "app.attrails.route#mtb",
            "app.attrails.route#touring",
            "app.attrails.route#commute"
          ]
        }
      }
    },
    "gravelBike": {
      "type": "token",
      "description": "Gravel / adventure cycling."
    },
    "main": {
      "type": "record",
      "description": "A cycling, running, hiking, walking, etc. route shared by a user. The associated track file is stored as a blob.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "name",
          "activity",
          "track",
          "createdAt"
        ],
        "properties": {
          "activity": {
            "type": "string",
            "description": "The activity this route is intended for. Open enum; unknown values are allowed.",
            "knownValues": [
              "app.attrails.defs#cycling",
              "app.attrails.defs#running",
              "app.attrails.defs#hiking",
              "app.attrails.defs#walking",
              "app.attrails.defs#other"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "description": "Description of the route, as CommonMark markdown. Clients must not render raw HTML.",
            "maxLength": 30000,
            "maxGraphemes": 3000
          },
          "details": {
            "type": "union",
            "description": "Activity-specific attributes. Open union: new activity detail types can be added later without breaking existing clients.",
            "refs": [
              "app.attrails.route#cyclingDetails"
            ]
          },
          "difficulty": {
            "type": "string",
            "description": "Author's subjective difficulty for the stated activity.",
            "knownValues": [
              "app.attrails.defs#easy",
              "app.attrails.defs#moderate",
              "app.attrails.defs#hard",
              "app.attrails.defs#extreme"
            ]
          },
          "images": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "app.attrails.defs#image"
            },
            "maxLength": 10
          },
          "labels": {
            "type": "union",
            "description": "Self-label values for this route, e.g. to flag sensitive photos.",
            "refs": [
              "com.atproto.label.defs#selfLabels"
            ]
          },
          "langs": {
            "type": "array",
            "description": "Languages of this record's text (name, description, tags, image alt text), as BCP-47 tags. If absent, consumers should assume English ('en').",
            "items": {
              "type": "string",
              "format": "language"
            },
            "maxLength": 3
          },
          "name": {
            "type": "string",
            "description": "Name of the route.",
            "minLength": 1,
            "maxLength": 1000,
            "maxGraphemes": 100
          },
          "surface": {
            "type": "string",
            "description": "Predominant surface. Activity-neutral.",
            "knownValues": [
              "app.attrails.defs#paved",
              "app.attrails.defs#gravel",
              "app.attrails.defs#trail",
              "app.attrails.defs#mixed"
            ]
          },
          "tags": {
            "type": "array",
            "description": "Free-form tags, stored without a leading '#'.",
            "items": {
              "type": "string",
              "maxLength": 640,
              "maxGraphemes": 64
            },
            "maxLength": 20
          },
          "track": {
            "type": "blob",
            "description": "The route's track, commonly as a GPX file. Subject to max size limitations imposed by the user's PDS, so large routes might need to be simplified or compressed to fit.",
            "accept": [
              "application/gpx+xml",
              "application/xml",
              "text/xml"
            ],
            "maxSize": 976563
          }
        }
      }
    },
    "mtb": {
      "type": "token",
      "description": "Mountain biking."
    },
    "road": {
      "type": "token",
      "description": "Road cycling."
    },
    "touring": {
      "type": "token",
      "description": "Multi-day touring / bikepacking."
    }
  }
}