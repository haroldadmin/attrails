{
  "records": [
    {
      "value": {
        "lexicon": 1,
        "id": "app.attrails.defs",
        "defs": {
          "image": {
            "type": "object",
            "description": "A photo attached to a route or review.",
            "required": [
              "image",
              "alt"
            ],
            "properties": {
              "image": {
                "type": "blob",
                "accept": [
                  "image/*"
                ],
                "maxSize": 1000000
              },
              "alt": {
                "type": "string",
                "description": "Alt text for accessibility. May be empty.",
                "maxGraphemes": 2000,
                "maxLength": 20000
              },
              "aspectRatio": {
                "type": "ref",
                "ref": "#aspectRatio"
              }
            }
          },
          "aspectRatio": {
            "type": "object",
            "description": "Width:height ratio so clients can lay out before the image loads.",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "cycling": {
            "type": "token",
            "description": "Cycling of any kind."
          },
          "running": {
            "type": "token",
            "description": "Running or jogging."
          },
          "hiking": {
            "type": "token",
            "description": "Hiking or trekking."
          },
          "walking": {
            "type": "token",
            "description": "Walking."
          },
          "other": {
            "type": "token",
            "description": "Any other activity."
          },
          "paved": {
            "type": "token",
            "description": "Entirely paved."
          },
          "gravel": {
            "type": "token",
            "description": "Mostly gravel / unpaved roads."
          },
          "trail": {
            "type": "token",
            "description": "Singletrack, footpath or trail."
          },
          "mixed": {
            "type": "token",
            "description": "Mix of surfaces."
          },
          "easy": {
            "type": "token",
            "description": "Easy for the stated activity."
          },
          "moderate": {
            "type": "token",
            "description": "Moderate for the stated activity."
          },
          "hard": {
            "type": "token",
            "description": "Hard for the stated activity."
          },
          "extreme": {
            "type": "token",
            "description": "Extreme for the stated activity."
          }
        }
      }
    },
    {
      "value": {
        "lexicon": 1,
        "id": "app.attrails.route",
        "defs": {
          "main": {
            "type": "record",
            "description": "A cycling, running, hiking, walking, etc. route shared by a user. The associated track file is stored as a blob.",
            "key": "tid",
            "record": {
              "type": "object",
              "required": [
                "name",
                "activity",
                "track",
                "createdAt"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the route.",
                  "minLength": 1,
                  "maxGraphemes": 100,
                  "maxLength": 1000
                },
                "description": {
                  "type": "string",
                  "description": "Description of the route, as CommonMark markdown. Clients must not render raw HTML.",
                  "maxGraphemes": 3000,
                  "maxLength": 30000
                },
                "langs": {
                  "type": "array",
                  "description": "Languages of this record's text (name, description, tags, image alt text), as BCP-47 tags. If absent, consumers should assume English ('en').",
                  "maxLength": 3,
                  "items": {
                    "type": "string",
                    "format": "language"
                  }
                },
                "track": {
                  "type": "blob",
                  "description": "The route's track, commonly as a GPX file. Subject to max size limitations imposed by the user's PDS, so large routes might need to be simplified or compressed to fit.",
                  "accept": [
                    "application/gpx+xml",
                    "application/xml",
                    "text/xml"
                  ],
                  "maxSize": 976563
                },
                "activity": {
                  "type": "string",
                  "description": "The activity this route is intended for. Open enum; unknown values are allowed.",
                  "knownValues": [
                    "app.attrails.defs#cycling",
                    "app.attrails.defs#running",
                    "app.attrails.defs#hiking",
                    "app.attrails.defs#walking",
                    "app.attrails.defs#other"
                  ]
                },
                "surface": {
                  "type": "string",
                  "description": "Predominant surface. Activity-neutral.",
                  "knownValues": [
                    "app.attrails.defs#paved",
                    "app.attrails.defs#gravel",
                    "app.attrails.defs#trail",
                    "app.attrails.defs#mixed"
                  ]
                },
                "difficulty": {
                  "type": "string",
                  "description": "Author's subjective difficulty for the stated activity.",
                  "knownValues": [
                    "app.attrails.defs#easy",
                    "app.attrails.defs#moderate",
                    "app.attrails.defs#hard",
                    "app.attrails.defs#extreme"
                  ]
                },
                "details": {
                  "type": "union",
                  "description": "Activity-specific attributes. Open union: new activity detail types can be added later without breaking existing clients.",
                  "refs": [
                    "app.attrails.route#cyclingDetails"
                  ]
                },
                "tags": {
                  "type": "array",
                  "description": "Free-form tags, stored without a leading '#'.",
                  "maxLength": 20,
                  "items": {
                    "type": "string",
                    "maxGraphemes": 64,
                    "maxLength": 640
                  }
                },
                "images": {
                  "type": "array",
                  "maxLength": 10,
                  "items": {
                    "type": "ref",
                    "ref": "app.attrails.defs#image"
                  }
                },
                "labels": {
                  "type": "union",
                  "description": "Self-label values for this route, e.g. to flag sensitive photos.",
                  "refs": [
                    "com.atproto.label.defs#selfLabels"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "datetime"
                }
              }
            }
          },
          "cyclingDetails": {
            "type": "object",
            "description": "Cycling-specific attributes of a route.",
            "properties": {
              "discipline": {
                "type": "string",
                "knownValues": [
                  "app.attrails.route#road",
                  "app.attrails.route#gravelBike",
                  "app.attrails.route#mtb",
                  "app.attrails.route#touring",
                  "app.attrails.route#commute"
                ]
              }
            }
          },
          "road": {
            "type": "token",
            "description": "Road cycling."
          },
          "gravelBike": {
            "type": "token",
            "description": "Gravel / adventure cycling."
          },
          "mtb": {
            "type": "token",
            "description": "Mountain biking."
          },
          "touring": {
            "type": "token",
            "description": "Multi-day touring / bikepacking."
          },
          "commute": {
            "type": "token",
            "description": "Utility / commuting."
          }
        }
      }
    },
    {
      "value": {
        "lexicon": 1,
        "id": "app.attrails.review",
        "defs": {
          "main": {
            "type": "record",
            "description": "A review of a route: a 1-5 rating, optional text, and optional photos. Activity-neutral. The AppView treats the most recent review per (author, subject) as canonical.",
            "key": "tid",
            "record": {
              "type": "object",
              "required": [
                "subject",
                "rating",
                "createdAt"
              ],
              "properties": {
                "subject": {
                  "type": "ref",
                  "description": "Strong reference to an attrails record, often an app.attrails.route record.",
                  "ref": "com.atproto.repo.strongRef"
                },
                "rating": {
                  "type": "integer",
                  "description": "Star rating from 1 (worst) to 5 (best).",
                  "minimum": 1,
                  "maximum": 5
                },
                "text": {
                  "type": "string",
                  "description": "Review text, as CommonMark markdown. Clients must not render raw HTML.",
                  "maxGraphemes": 3000,
                  "maxLength": 30000
                },
                "langs": {
                  "type": "array",
                  "description": "Languages of this record's text (review text, image alt text), as BCP-47 tags. If absent, consumers should assume English ('en').",
                  "maxLength": 3,
                  "items": {
                    "type": "string",
                    "format": "language"
                  }
                },
                "images": {
                  "type": "array",
                  "maxLength": 10,
                  "items": {
                    "type": "ref",
                    "ref": "app.attrails.defs#image"
                  }
                },
                "labels": {
                  "type": "union",
                  "description": "Self-label values for this review, e.g. to flag sensitive photos.",
                  "refs": [
                    "com.atproto.label.defs#selfLabels"
                  ]
                },
                "completedAt": {
                  "type": "string",
                  "description": "When the reviewer last did the route (rode, ran, hiked), if they want to say.",
                  "format": "datetime"
                },
                "createdAt": {
                  "type": "string",
                  "format": "datetime"
                }
              }
            }
          }
        }
      }
    },
    {
      "value": {
        "lexicon": 1,
        "id": "app.attrails.actor.profile",
        "defs": {
          "main": {
            "type": "record",
            "description": "A user's ATTrails profile. The existence of this record is the signal that an account is an ATTrails user.",
            "key": "literal:self",
            "record": {
              "type": "object",
              "required": [
                "name",
                "createdAt"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Display name.",
                  "minLength": 1,
                  "maxGraphemes": 100,
                  "maxLength": 1000
                },
                "bio": {
                  "type": "string",
                  "description": "Short free-text biography.",
                  "maxGraphemes": 3000,
                  "maxLength": 30000
                },
                "profilePicture": {
                  "type": "blob",
                  "description": "Profile picture. Upload with an image/* Content-Type. maxSize matches app.attrails.defs#image (1MB).",
                  "accept": [
                    "image/*"
                  ],
                  "maxSize": 1000000
                },
                "labels": {
                  "type": "union",
                  "description": "Self-label values for this profile.",
                  "refs": [
                    "com.atproto.label.defs#selfLabels"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "datetime"
                }
              }
            }
          }
        }
      }
    }
  ]
}