ATTRAILS_POSTGRES_CONNECTION_URI='postgresql://<username>:<password>@<hostname>:<port>/<dbname>'

ATTRAILS_RABBITMQ_HOST='amqp://<username>:<password>@<hostname>:<port>'

ATTRAILS_TAP_URL='<ws:// compatible hostname>'
ATTRAILS_TAP_ADMIN_PASSWORD='<password>'

# Health probe port. Defaults to 8080 for ingest-watcher and 8081 for
# ingest-consumer. Set explicitly when running both on the same host.
# ATTRAILS_HEALTH_PORT='8080'

# Jev decisions API used by ingest-consumer to label records.
ATTRAILS_DECISIONS_API_KEY='<api key>'
# ATTRAILS_DECISIONS_API_BASE_URL='https://api.typesafe.ai'

ATTRAILS_WEB_URL='http://127.0.0.1:3000'

# Required unless ATTRAILS_WEB_URL is on 127.0.0.1.
# Generate a value once with web/scripts/keygen.mts
# ATTRAILS_OAUTH_PRIVATE_KEY='{"kty":"EC",...}'
