ATTRAILS_POSTGRES_CONNECTION_URI='postgresql://<username>:<password>@<hostname>:<port>/<dbname>'

ATTRAILS_RABBITMQ_HOST='amqp://<username>:<password>@<hostname>:<port>'

ATTRAILS_TAP_URL='<ws:// compatible hostname>'
ATTRAILS_TAP_ADMIN_PASSWORD='<password>'

# Port for the liveness and readiness probes. Each process needs its own port
# when running ingest-watcher and ingest-consumer locally.
ATTRAILS_HEALTH_PORT='8080'

